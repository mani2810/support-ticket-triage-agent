# ---- copy to backend/.env and fill in (only GROQ_API_KEY is needed locally) ----
ENVIRONMENT=development

# ---- LLM: Groq (free key: https://console.groq.com/keys). Empty -> keyword-rules classifier ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_MODE=groq
# Resilience / request economy (defaults are tuned for the Groq free tier)
LLM_TIMEOUT_SECONDS=10
LLM_MAX_ATTEMPTS=2
LLM_MAX_CALLS_PER_MINUTE=25
LLM_BREAKER_FAILURES=3
LLM_BREAKER_RESET_SECONDS=60
LLM_CACHE_TTL_SECONDS=3600

# ---- Database: relative SQLite paths are resolved against backend/ ----
# Production: postgresql+psycopg2://user:password@host:5432/triagedesk
DATABASE_URL=sqlite:///./triage.db

# ---- Auth ----
# Leave empty locally: a random secret is generated once in backend/.secrets/ (git-ignored).
# Production: set your own, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=480
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Stay logged in across page refreshes (refresh tokens, rotated on every use)
REFRESH_TOKEN_DAYS=7

# First admin account (created on startup if no admin exists). Change the password after first login.
BOOTSTRAP_ADMIN_EMAIL=admin@triagedesk.dev
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026

# ---- Customer photo uploads (relative dir resolves against backend/; git-ignored) ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
MAX_IMAGES_PER_TICKET=3
MAX_IMAGES_TOTAL=9
# Item problems (damaged/missing/wrong/quality) must be reported within N days of delivery
TICKET_WINDOW_DAYS=30

# ---- Logging: text (readable) or json (log shippers); optional rotating file ----
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=

# ---- E-mail notifications: SMTP when SMTP_HOST is set, otherwise .eml files in backend/outbox/ ----
NOTIFY_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FreshCart Support <support@freshcart.local>
APP_URL=http://localhost:8501

# ---- HTTP ----
CORS_ORIGINS=["http://localhost:8501"]
PUBLIC_RATE_LIMIT=10/minute
# Peers allowed to pass the end-user IP in X-Forwarded-For (the Streamlit server). JSON list.
TRUSTED_PROXIES=["127.0.0.1","::1"]
# API docs at /docs: empty = on in development, off in production
ENABLE_DOCS=
